<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!--
		Client network access.

		Without it the macOS sandbox resolves no host at all: `Failed host lookup`
		occurs before any connection attempt, and the document and theme are
		silently taken from the bundle. That looks like "no network", and the
		network path is never exercised because the fallback always kicks in.

		iOS and Android need no such permission, so on a phone everything works;
		the macOS build is the one that would go unchecked.
	-->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
