  "sectionCases": [
    { "name": "from one section to another: the stack is the new section", "stack": ["home"], "target": "rewards", "expect": ["rewards"] },
    { "name": "the stack is already that one screen: nothing happens", "stack": ["rewards"], "target": "rewards", "expect": null },
    { "name": "from a deeper stack: everything above is closed", "stack": ["home", "details", "confirm"], "target": "rewards", "expect": ["rewards"] },
    { "name": "to the screen at the bottom of a deeper stack: the stack is cut to it, and that is a switch", "stack": ["home", "details"], "target": "home", "expect": ["home"] },
    { "name": "the section screen lies on top of another screen (it was opened by navigate): a switch to it makes it the only one", "stack": ["home", "rewards"], "target": "rewards", "expect": ["rewards"] }
  ],

